# Copy to `.env.local` (git-ignored) and adjust as needed.

# API prefix every request is built against. Defaults to `/iam`; do not add a
# trailing slash. Only set it when the public reverse-proxy prefix differs.
# VITE_API_BASE=/iam

# Development-only mock backend. With `VITE_MOCK=1` a dev build answers every
# API call from the in-memory mock in `src/api/mock/`, so `corepack pnpm dev`
# works with no IAM service running. It is ignored in production builds: the
# mock is behind an `import.meta.env.DEV` guard plus a dynamic import, so it is
# never part of the production bundle.
# VITE_MOCK=1
